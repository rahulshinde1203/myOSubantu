[Unit]
Description=Ubuntu Server OS Web Application Daemon
After=network.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntulos
Group=ubuntulos
WorkingDirectory=/opt/ubuntu-server-os
Environment="PATH=/opt/ubuntu-server-os/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="UBUNTU_OS_ENV=production"
Environment="UBUNTU_OS_DB_PATH=/var/lib/ubuntu-server-os/ubuntu_os.db"
Environment="PYTHONUNBUFFERED=1"

# Execute Gunicorn binding to localhost port 5000
ExecStart=/opt/ubuntu-server-os/.venv/bin/gunicorn \
    --workers 2 \
    --timeout 60 \
    --bind 127.0.0.1:5000 \
    "server:create_app()"

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=15
Restart=on-failure
RestartSec=3s

# Runtime directory with strict ownership
RuntimeDirectory=ubuntu-server-os
RuntimeDirectoryMode=0750

# Sandboxing & Kernel Security Hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/ubuntu-server-os /run/ubuntu-server-os /var/log/ubuntu-server-os
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
