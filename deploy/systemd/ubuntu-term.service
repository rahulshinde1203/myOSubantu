[Unit]
Description=Ubuntu Server OS Isolated Terminal Gateway Daemon
After=network.target ubuntu-os.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntulos
Group=ubuntulos
WorkingDirectory=/opt/ubuntu-server-os
Environment="PATH=/opt/ubuntu-server-os/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="UBUNTU_OS_ENV=production"

ExecStart=/opt/ubuntu-server-os/.venv/bin/python3 -m server.terminal.gateway
Restart=on-failure
RestartSec=3s

# Security Hardening
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
